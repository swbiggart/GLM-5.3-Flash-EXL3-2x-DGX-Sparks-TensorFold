+        var mod = try cuda.Module.load(d, cuda.kernels.glm_neighbor_rdma);
+        errdefer mod.unload();
+        const k = try rdma.Kernels.load(mod);
+        const s: rdma.Settings = .{ .max_bytes = 2 * cutoff, .gid_index = gid };
+        const first = try rdma.Ring.create(gpa, d, k, &first_devs, rank % 2, 2, s);
+        errdefer first.destroy(gpa);
+        const second = try rdma.Ring.create(gpa, d, k, &second_devs, rank / 2, 2, s);
+        errdefer second.destroy(gpa);
+        var scratch = try cuda.DeviceBuffer.alloc(d, 2 * cutoff);
+        errdefer scratch.free();
+        first.failure_peer = second;
+        second.failure_peer = first;
+        return .{ .gpa = gpa, .mod = mod, .first = first, .second = second, .scratch = scratch, .rank = rank };
+    }
+    pub fn info(n: *const Gather) Info {
+        return .{ n.first.info(0), n.first.info(1), n.second.info(0), n.second.info(1) };
+    }
+    pub fn connect(n: *Gather, all: *const [4]Info) !void {
+        const g = n.rank;
+        const mine = n.info();
+        var a: [2]rdma.Info = undefined;
+        var b: [2]rdma.Info = undefined;
+        a[g % 2] = mine[g % 2];
+        a[1 - g % 2] = all[g ^ 1][g % 2];
+        b[g / 2] = mine[2 + g / 2];
+        b[1 - g / 2] = all[g ^ 3][2 + g / 2];
+        try n.first.connect(&a);
+        try n.second.connect(&b);
+    }
