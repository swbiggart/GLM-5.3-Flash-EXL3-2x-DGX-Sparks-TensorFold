+    const ae = std.math.add(u64, a, an) catch return false;
+    const be = std.math.add(u64, b, bn) catch return false;
+    return ae <= b or be <= a;
+}
+fn devices(text: []const u8) ![2][]const u8 {
+    var it = std.mem.splitScalar(u8, text, ',');
+    const a = it.next() orelse return error.BadNeighborDevices;
+    const b = it.next() orelse return error.BadNeighborDevices;
+    if (a.len == 0 or b.len == 0 or it.next() != null or std.mem.eql(u8, a, b)) return error.BadNeighborDevices;
+    for (a) |c| if (c <= ' ' or c == ':' or c == '=') return error.BadNeighborDevices;
+    for (b) |c| if (c <= ' ' or c == ':' or c == '=') return error.BadNeighborDevices;
+    return .{ a, b };
+}
+
+test "neighbor dispatch excludes size alignment and every alias before enqueue" {
+    try std.testing.expect(eligible(0x100000, 0x300000, cutoff));
+    for ([_]usize{ 0, 4, 8, 15, cutoff + 16 }) |b| try std.testing.expect(!eligible(0x100000, 0x300000, b));
+    try std.testing.expect(!eligible(0x100004, 0x300000, 16));
+    try std.testing.expect(!eligible(0x100000, 0x100000, 16));
+    try std.testing.expect(!eligible(0x100010, 0x100000, 16)); // in-place rank one
+    try std.testing.expect(!eligible(0x100000, 0x100010, 32));
+    try std.testing.expect(!eligible(std.math.maxInt(u64) - 15, 16, 16));
+}
+test "two matchings retain global rank order" {
+    for (0..4) |g| {
+        var out: [4]usize = undefined;
+        for (0..2) |p| {
+            const owner = if (p == g / 2) g else g ^ 3;
+            out[2 * p] = owner & ~@as(usize, 1);
+            out[2 * p + 1] = owner | 1;
+        }
+        try std.testing.expectEqual([4]usize{ 0, 1, 2, 3 }, out);
+    }
+    _ = try devices("rocep1s0f0,roceP2p1s0f0");
+    for ([_][]const u8{ "", "a", "a,a", "a,b,c", "a, b", "a:1,b" }) |v| try std.testing.expectError(error.BadNeighborDevices, devices(v));
+}
+
+pub fn validateProfile(first_text: []const u8, second_text: []const u8, gid: u8) !void {
+    if (gid != 3) return error.BadNeighborTopology;
+    const first = try devices(first_text);
+    const second = try devices(second_text);
+    for (first) |a| for (second) |b| if (std.mem.eql(u8, a, b)) return error.NeighborDevicesOverlap;
+}
