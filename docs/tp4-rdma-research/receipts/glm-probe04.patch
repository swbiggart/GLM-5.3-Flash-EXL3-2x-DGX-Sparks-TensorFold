+// Probe support is intentionally bounded. Read the live relay's agreed slot size,
+// not an environment default. Neighbor's production cutoff remains fixed at 512 KiB.
+const max_probe_bytes: usize = (1024 << 10) + 16;
+fn activeCutoff(comm: *const Comm) u64 {
+    if (comm.extra) |x| {
+        if (x.r) |r| return r.slot_bytes;
+        if (x.n != null) return 512 << 10;
+    }
+    return 0;
+}
+fn parseProfile(text: []const u8) !Comm.GatherBackend {
+    return std.meta.stringToEnum(Comm.GatherBackend, text) orelse error.BadProbeProfile;
+}
+const SizePlan = struct {
+    cutoff: u64,
+    eager: [12]usize = .{ 8, 16, 68, 4096, 16384, 98304, 262144, 524288, 524304, 1048576, 0, 0 },
+    eager_len: usize = 10,
+    mixed: [3]usize = .{ 16384, 524304, 32768 },
+
+    fn init(backend: Comm.GatherBackend, cutoff: u64) !SizePlan {
+        switch (backend) {
+            .nccl => if (cutoff != 0) return error.ProbeProfileMismatch,
+            .neighbor => if (cutoff != 512 << 10) return error.UnsupportedProbeCutoff,
+            .roce => if (cutoff != 512 << 10 and cutoff != 1024 << 10) return error.UnsupportedProbeCutoff,
+        }
+        var out: SizePlan = .{ .cutoff = cutoff };
+        if (cutoff == 1024 << 10) {
+            // 33 FP32 GLM rows, just beyond cutoff, 64 FP32 GLM rows.
+            // Exactly two custom calls, preserving replay counter expectations.
+            out.mixed = .{ 33 * 4096 * 4, max_probe_bytes, 64 * 4096 * 4 };
+            out.eager[10] = out.mixed[0];
+            out.eager[11] = max_probe_bytes;
+            out.eager_len = out.eager.len;
+        }
+        return out;
+    }
+};
+const CaseSizes = struct { send: usize, recv: usize, oracle: usize };
+fn caseSizes(bytes: usize, offset: usize) !CaseSizes {
+    if (bytes == 0 or bytes > max_probe_bytes or (offset != 0 and offset != 4)) return error.UnsupportedProbeCase;
+    const payload = try std.math.mul(usize, 4, bytes);
+    const edges = try std.math.add(usize, 2 * guard, offset);
+    return .{ .send = try std.math.add(usize, bytes, edges), .recv = try std.math.add(usize, payload, edges), .oracle = payload };
+}
