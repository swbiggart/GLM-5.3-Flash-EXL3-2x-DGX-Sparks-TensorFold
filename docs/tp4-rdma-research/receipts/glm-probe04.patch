+test "graph counter size plan retains 512 KiB cases and extends relay to 64 rows" {
+    const original = [_]usize{ 16384, 524304, 32768 };
+    const nccl = try SizePlan.init(.nccl, 0);
+    const neighbor = try SizePlan.init(.neighbor, 512 << 10);
+    const relay = try SizePlan.init(.roce, 512 << 10);
+    for ([_]SizePlan{ nccl, neighbor, relay }) |plan| {
+        try std.testing.expectEqualSlices(usize, &original, &plan.mixed);
+        try std.testing.expectEqual(@as(usize, 10), plan.eager_len);
+    }
+    const large = try SizePlan.init(.roce, 1024 << 10);
+    try std.testing.expectEqualSlices(usize, &.{ 540672, 1048592, 1048576 }, &large.mixed);
+    try std.testing.expectEqual(@as(usize, 12), large.eager_len);
+    try std.testing.expectEqual(max_probe_bytes, large.eager[large.eager_len - 1]);
+    var custom: usize = 0;
+    for (large.mixed) |bytes| {
+        _ = try caseSizes(bytes, 0);
+        if (bytes <= large.cutoff) custom += 1;
+    }
+    try std.testing.expectEqual(@as(usize, 2), custom);
+    try std.testing.expect(large.mixed[1] > large.cutoff);
+}
+
+test "graph counter size planning refuses unsupported profiles and buffer bounds" {
+    for ([_]u64{ 0, 128 << 10, 768 << 10, 2048 << 10, std.math.maxInt(u64) }) |cutoff|
+        try std.testing.expectError(error.UnsupportedProbeCutoff, SizePlan.init(.roce, cutoff));
+    try std.testing.expectError(error.UnsupportedProbeCutoff, SizePlan.init(.neighbor, 1024 << 10));
+    try std.testing.expectError(error.ProbeProfileMismatch, SizePlan.init(.nccl, 512 << 10));
+    for ([_][]const u8{ "", "auto", "ROCE", "registered", " roce" }) |bad|
+        try std.testing.expectError(error.BadProbeProfile, parseProfile(bad));
+    try std.testing.expectEqual(Comm.GatherBackend.roce, try parseProfile("roce"));
+    for ([_]usize{ 0, max_probe_bytes + 1, std.math.maxInt(usize) }) |bytes|
+        try std.testing.expectError(error.UnsupportedProbeCase, caseSizes(bytes, 0));
+    try std.testing.expectError(error.UnsupportedProbeCase, caseSizes(16, std.math.maxInt(usize)));
+    const sizes = try caseSizes(max_probe_bytes, 4);
+    try std.testing.expectEqual(@as(usize, 4194368), sizes.oracle);
+    try std.testing.expectEqual(sizes.oracle + 132, sizes.recv);
+    try std.testing.expectEqual(max_probe_bytes + 132, sizes.send);
+    // Last rank's in-place source ends at payload end, before the trailing guard.
+    try std.testing.expectEqual(guard + 4 + 4 * max_probe_bytes, sizes.recv - guard);
+}
