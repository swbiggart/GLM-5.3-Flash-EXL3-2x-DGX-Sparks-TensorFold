+// Fail at the call site, before any CUDA/transport resource defers can block.
+// Keep the original error; Zig 0.17 does not support errdefer error capture.
+fn checked(rank: u32, result: anytype) @typeInfo(@TypeOf(result)).error_union.payload {
+    return result catch |e| die(e, rank);
+}
+
 fn die(e: anyerror, rank: u32) noreturn {
     std.debug.print("FAIL rank={d} error={t} (fleet supervisor must stop peers)\n", .{ rank, e });
     std.c._exit(1);
 }
 
+fn phase(rank: u32, name: []const u8) void {
+    if (@import("builtin").is_test) return;
+    std.debug.print("PHASE rank={d} stage={s}\n", .{ rank, name });
+}
+fn snapshot(rank: u32, name: []const u8, s: Comm.Stats) void {
+    if (@import("builtin").is_test) return;
+    std.debug.print("SNAPSHOT rank={d} stage={s} nccl_enqueues={d} roce_enqueues={d} neighbor_enqueues={d} first={d} second={d} roce_ops={d} relay_stripes={d}\n", .{ rank, name, s.nccl_enqueues, s.roce_enqueues, s.neighbor_enqueues, s.neighbor_first_completed, s.neighbor_second_completed, s.roce_ops, s.relayed_stripes });
+}
+
+// Snapshot BEFORE the barrier: a fast rank must not replay until every peer has
+// sampled its counters. A peer's relay proxy can forward remote stripes before
+// its own GPU launches anything, so a barrier before sampling is insufficient.
+fn captureReady(gpa: std.mem.Allocator, link: anytype, rank: u32, drained: Comm.Stats, before: Comm.Stats) !void {
+    snapshot(rank, "capture_snapshot", before);
+    if (!sameExecutionCounts(drained, before)) {
+        snapshot(rank, "capture_expected", drained);
+        return error.CaptureExecutedTransport;
+    }
+    phase(rank, "capture_snapshot_barrier");
+    try link.agreeRanks(gpa, rank, "glm-transport-probe capture snapshots complete");
+}
