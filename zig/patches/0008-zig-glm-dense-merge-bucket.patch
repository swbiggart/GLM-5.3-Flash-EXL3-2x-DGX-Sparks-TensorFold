+    fn denseAttention(e: Engine, rows: usize, pos: usize, lc: u64) !void {
+        const h = e.g.heads;
+        const s = &e.s;
+        // Five chunks cover all dense keys; neutral partials preserve order and NCH=5 covers every captured R class.
+        const nch = cdiv(grid.sparse_from, grid.att_rows);
+        if (pos < grid.sparse_from) {
+            const dense = grid.denseRows(rows, pos);
+            const hb = grid.headBlock(rows);
+            if (dense <= grid.att_rows) {
+                try e.denseBlock(s.qa, lc, s.ol, dense, e.pos_dev, nch, hb);
+            } else {
+                var r0: usize = 0;
+                var block: usize = 0;
+                while (r0 < dense) {
+                    const n = @min(grid.att_rows, dense - r0);
+                    const at: u64 = if (r0 == 0) e.pos_dev else s.origins + block * 16;
+                    try e.denseBlock(s.qa + r0 * h * 512 * 2, lc, s.ol + r0 * h * 512 * 2, n, at, nch, hb);
+                    r0 += n;
+                    block += 1;
+                }
+            }
+        }
+    }
