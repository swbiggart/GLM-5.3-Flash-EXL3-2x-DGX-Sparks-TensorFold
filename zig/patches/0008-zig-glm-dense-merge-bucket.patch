+
+test "dense prompt attention finds captured kernels across chunk and row boundaries" {
+    const aot = cuda.aot;
+    const parsed = try std.json.parseFromSlice(aot.SetJson, std.testing.allocator, @embedFile("fixtures_aot_variants.json"), .{ .ignore_unknown_fields = true });
+    defer parsed.deinit();
+    const Case = struct { pos: usize, rows: usize };
+    // Real prompt chunks: a 64-aligned prefix, then its short tail in a separate call.
+    const cases = [_]Case{
+        .{ .pos = 0, .rows = 1152 }, // 1193-token prompt's prefix: formerly NCH=3, R=512.
+        .{ .pos = 1152, .rows = 41 },
+        .{ .pos = 0, .rows = 1 },
+        .{ .pos = 0, .rows = 15 },
+        .{ .pos = 0, .rows = 16 },
+        .{ .pos = 0, .rows = 63 },
+        .{ .pos = 0, .rows = 64 },
+        .{ .pos = 0, .rows = 448 },
+        .{ .pos = 448, .rows = 63 },
+        .{ .pos = 0, .rows = 512 },
+        .{ .pos = 512, .rows = 1 },
+        .{ .pos = 0, .rows = 1024 },
+        .{ .pos = 1024, .rows = 1 },
+        .{ .pos = 0, .rows = 1088 },
+        .{ .pos = 0, .rows = 1536 },
+        .{ .pos = 1536, .rows = 1 },
+        .{ .pos = 0, .rows = 1600 },
+        .{ .pos = 0, .rows = 2048 },
+        .{ .pos = 2048, .rows = 1 },
+        .{ .pos = 2048, .rows = 2 },
+        .{ .pos = 2048, .rows = 3 },
+        .{ .pos = 2048, .rows = 4 },
+        .{ .pos = 0, .rows = 2560 },
+        .{ .pos = 0, .rows = 3072 },
+        .{ .pos = 0, .rows = 3584 },
+        .{ .pos = 0, .rows = 4096 },
+        .{ .pos = 2048, .rows = 64 },
+        .{ .pos = 2048, .rows = 1024 },
+        .{ .pos = 2048, .rows = 1536 },
+        .{ .pos = 2048, .rows = 2048 },
+        .{ .pos = 2112, .rows = 2048 },
+        .{ .pos = 0, .rows = 16384 },
+        .{ .pos = 2048, .rows = 16384 },
+    };
+    for (cases) |c| {
+        var rec: @import("cuda_triton.zig").Recorder = .{};
+        var e: Engine = undefined;
+        e.g = try state.Geometry.init(2, 0);
+        e.tri = .{ .rec = &rec };
+        e.pos_dev = 4096;
+        e.s.nch = 5;
+        e.s.part_rows = grid.att_rows;
+        e.s.qa = 8192;
+        e.s.ol = 12288;
+        e.s.po = 16384;
+        e.s.pm = 20480;
+        e.s.pl = 24576;
+        e.s.dummy = 28672;
+        e.s.origins = 32768;
+        try e.denseAttention(c.rows, c.pos, 36864);
+        const dense = grid.denseRows(c.rows, c.pos);
+        try std.testing.expectEqual(2 * cdiv(dense, grid.att_rows), rec.n);
+        var written: usize = 0;
+        for (rec.launches[0..rec.n], 0..) |launch, i| {
+            const matched = for (parsed.value.kernels) |k| {
+                if (std.mem.eql(u8, k.@"fn", launch.name) and
+                    aot.matches(k, launch.args[0..launch.nargs], launch.consts[0..launch.nconsts])) break true;
+            } else false;
+            if (!matched) std.debug.print("uncaptured {s}: pos={d} rows={d}, grid={any}\n", .{ launch.name, c.pos, c.rows, launch.grid });
+            try std.testing.expect(matched);
+            const n = @min(grid.att_rows, dense - written);
+            try std.testing.expectEqual(n, launch.grid[0]);
+            if (i % 2 == 0) {
+                try std.testing.expectEqualStrings("_dense_chunks", launch.name);
+            } else {
+                try std.testing.expectEqualStrings("_merge", launch.name);
+                const nch = for (launch.consts[0..launch.nconsts]) |v| {
+                    if (std.mem.eql(u8, v.name, "NCH")) break v.int.?;
+                } else unreachable;
+                try std.testing.expectEqual(nch, rec.launches[i - 1].grid[2]);
+                try std.testing.expect(nch * 512 >= c.pos + written + n);
+                written += n;
+            }
+        }
+        try std.testing.expectEqual(dense, written);
+    }
+}
